        }
      },
      "id": "tt-status-0001",
      "name": "Fetch Publish Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 640]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "position",
        "options": {}
      },
      "id": "tt-merges-0001",
      "name": "Merge Status",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1580, 640]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sd = $getWorkflowStaticData('global');\nsd.polls = ($('Fetch Publish Status').all().length ? (sd.polls || 0) : (sd.polls || 0)) ;\nreturn $input.all().map(it => {\n  const j = it.json;\n  const prev = j;\n  const d = j.data || (j.body && j.body.data) || {};\n  const st = d.status || 'UNKNOWN';\n  const terminal = (st === 'PUBLISH_COMPLETE' || st === 'FAILED' || st === 'PUBLISH_FAILED');\n  return { json: {\n    video_url: prev.video_url, title: prev.title, post_mode: prev.post_mode,\n    privacy_level: prev.privacy_level, access_token: prev.access_token,\n    publish_id: prev.publish_id, init_ok: prev.init_ok,\n    tiktok_status: st,\n    terminal: terminal || !prev.init_ok,\n    fail_reason: d.fail_reason || null,\n    error: prev.error || (st === 'FAILED' ? ('TikTok publish failed: ' + (d.fail_reason || st)) : null)\n  } };\n});"
      },
      "id": "tt-norms-0001",
      "name": "Normalize Publish Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 640]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "tt-terminal",
              "leftValue": "={{ $json.terminal }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "tt-if-term-0001",
      "name": "Publish Terminal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2020, 640]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json;\nconst mode = j.post_mode;\nlet status = 'unknown';\nlet visibility = 'unknown';\nif (mode === 'INBOX') { status = j.init_ok ? 'draft_sent' : 'failed'; visibility = j.init_ok ? 'draft_in_tiktok_inbox' : 'none'; }\nelse { status = (j.tiktok_status === 'PUBLISH_COMPLETE') ? 'posted' : 'failed'; visibility = j.privacy_level.toLowerCase(); }\nreturn [{ json: {\n  status: status,\n  visibility: visibility,\n  publish_id: j.publish_id,\n  post_mode: mode,\n  tiktok_status: j.tiktok_status || null,\n  video_url: j.video_url,\n  title: j.title,\n  error: j.error || null,\n  fail_reason: j.fail_reason || null,\n  note: mode === 'INBOX' ? 'Video delivered to your TikTok inbox as a DRAFT. Nothing is public. Open TikTok to review and publish manually.' : ('Posted with privacy_level=' + j.privacy_level)\n} }];"
      },
      "id": "tt-out-0001",
      "name": "Build Upload Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2240, 540]
    }
  ],
