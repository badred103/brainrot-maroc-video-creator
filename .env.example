# Copy to .env and fill ONLY on your own machine. Never commit .env.
# These are used by scripts/*.mjs for local API smoke tests.
# Leave a value empty to skip that test.

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kling AI
KLING_API_KEY=
KLING_API_BASE=https://api.klingai.com
KLING_MODEL=kling-v1-6
KLING_MODE=std
KLING_DURATION=10
KLING_MAX_POLLS=20

# TikTok (client secret is required for token exchange; keep it local only)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
